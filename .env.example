# ===== GitHub Trending 爬虫 + Star 趋势追踪 环境变量示例 =====
# 复制为 .env 后按需填写：cp .env.example .env

# HTTP 服务端口（默认 3000；被占用可改为 3001）
# PORT=3000

# PostgreSQL 连接串（默认本机 github_trending 库）
# DATABASE_URL=postgres://用户名@localhost:5432/github_trending

# 飞书群自定义机器人 webhook（配置后每次拉取成功推送；不配置则不推送）
FEISHU_WEBHOOK=

# 火山豆包（ARK）API Key；不填则自动读 ~/.codex/auth.json 的 OPENAI_API_KEY
# ARK_API_KEY=

# 榜单接口缓存秒数（默认 600 = 10 分钟）
# CACHE_TTL_SEC=600

# 系统代理（爬 GitHub 用；若已全局设置可留空）
# HTTPS_PROXY=http://127.0.0.1:10808
